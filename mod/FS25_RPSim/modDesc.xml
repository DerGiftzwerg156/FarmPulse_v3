<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- FS25_RPSim: pure sensor/actuator for the FS25 AI role-play companion tool.
     Version follows SemVer and is coupled to CHANGELOG.md in the repository root. -->
<modDesc descVersion="92">
    <author>Keno</author>
    <version>1.5.1.0</version>
    <title>
        <en>RP Sim Bridge</en>
        <de>RP-Sim-Bridge</de>
    </title>
    <description>
        <en><![CDATA[File bridge for the "FS25 AI role-play simulation" companion tool. Exports farm facts, applies money transactions, price events and farmland transfers written by the local backend. Contains no game logic and no AI calls.]]></en>
        <de><![CDATA[Datei-Bridge für das Begleit-Tool "FS25 KI-Rollenspiel-Simulation". Exportiert Hofdaten, wendet Geldbuchungen, Preis-Events und Feldübertragungen an, die das lokale Backend schreibt. Enthält keine Spiellogik und keine KI-Anbindung.]]></de>
    </description>
    <!-- 512x512 BC1 icon, generated by tools/release/make-mod-icon.py -->
    <iconFilename>icon_RPSim.dds</iconFilename>
    <multiplayer supported="false"/>
    <extraSourceFiles>
        <sourceFile filename="src/loader.lua"/>
    </extraSourceFiles>
