{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instructions.schema.json",
  "title": "instructions.json (backend -> FS25_RPSim)",
  "type": "object",
  "required": ["savegameId", "instructions"],
  "properties": {
    "savegameId": { "type": "string" },
    "instructions": { "type": "array", "items": {
      "type": "object",
      "required": ["instructionId", "type"],
      "properties": {
        "instructionId": { "type": "string", "minLength": 1 },
        "batchId": { "type": "string" },
        "gameTimeEarliest": { "type": "number" },
        "type": { "enum": ["MONEY_TRANSACTION", "PRICE_EVENT", "FARMLAND_TRANSFER", "NOTIFICATION"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "MONEY_TRANSACTION" } } },
          "then": { "required": ["amount", "reason"], "properties": { "amount": { "type": "number" },
            "reason": { "enum": ["CREDIT_DISBURSEMENT", "CREDIT_INSTALLMENT", "CREDIT_PENALTY", "CREDIT_CALLBACK",
              "SALARY_PAYMENT", "EMPLOYEE_EFFECT", "SUBSIDY", "STARTING_CAPITAL_ADJUSTMENT", "FARMLAND_PURCHASE",
              "FARMLAND_SALE", "OTHER", "INSURANCE_PREMIUM", "INSURANCE_PAYOUT", "DAMAGE", "WILDLIFE_COMPENSATION",
              "VET_INVOICE", "LIVESTOCK_PREMIUM", "LEASE_PAYMENT", "MAINTENANCE_FEE"] }, "note": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "PRICE_EVENT" }, "priceMode": { "const": "MULTIPLIER" } } },
          "then": { "required": ["fillType", "sellPoint", "peakMultiplier", "rampUpHours", "holdHours", "decayHours"] } },
        { "if": { "properties": { "type": { "const": "PRICE_EVENT" }, "priceMode": { "const": "FIXED" } } },
          "then": { "required": ["fillType", "sellPoint", "fixedPrice", "maxQuantity", "deadlineGameTime"] } },
        { "if": { "properties": { "type": { "const": "PRICE_EVENT" } } },
          "then": { "required": ["priceMode"], "properties": { "priceMode": { "enum": ["MULTIPLIER", "FIXED"] } } } },
        { "if": { "properties": { "type": { "const": "FARMLAND_TRANSFER" } } },
          "then": { "required": ["farmlandId", "direction"], "properties": { "farmlandId": { "type": "integer" },
            "direction": { "enum": ["TO_PLAYER", "FROM_PLAYER"] }, "price": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "NOTIFICATION" } } },
          "then": { "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1 },
            "level": { "enum": ["INFO", "OK", "CRITICAL"] }, "expiresAtGameTime": { "type": "number" } } } }
      ]
    } }
  }
}
