{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "farm_facts.schema.json",
  "title": "farm_facts.json (FS25_RPSim export)",
  "type": "object",
  "required": ["schemaVersion", "gameTime", "savegameId", "liquidity", "assets", "liabilities", "prices"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameTime": { "type": "number", "minimum": 0 },
    "savegameId": { "type": "string", "minLength": 1 },
    "liquidity": { "type": "object", "required": ["balance"], "properties": { "balance": { "type": "number" } } },
    "assets": {
      "type": "object",
      "required": ["vehicles", "placeables", "farmland", "animals", "storage"],
      "properties": {
        "vehicles": { "type": "array", "items": { "type": "object", "required": ["uniqueId", "value", "condition"],
          "properties": { "uniqueId": { "type": "string" }, "value": { "type": "number", "minimum": 0 },
            "condition": { "type": "number", "minimum": 0, "maximum": 100 },
            "name": { "type": "string" }, "xmlFilename": { "type": "string" },
            "category": { "type": "string", "minLength": 1 },
            "fuel": { "type": "object", "required": ["liters", "capacity"], "properties": {
              "liters": { "type": "number", "minimum": 0 }, "capacity": { "type": "number", "exclusiveMinimum": 0 } } } } } },
        "placeables": { "type": "array", "items": { "type": "object", "required": ["uniqueId", "value"],
          "properties": { "uniqueId": { "type": "string" }, "value": { "type": "number", "minimum": 0 } } } },
        "farmland": { "type": "array", "items": { "type": "object", "required": ["farmlandId", "hectares", "price"],
          "properties": { "farmlandId": { "type": "integer" }, "hectares": { "type": "number", "minimum": 0 },
            "price": { "type": "number", "minimum": 0 } } } },
        "animals": { "type": "array", "items": { "type": "object",
          "required": ["husbandryUniqueId", "type", "count", "estimatedValue"],
          "properties": { "husbandryUniqueId": { "type": "string" }, "type": { "type": "string" },
            "count": { "type": "integer", "minimum": 0 }, "estimatedValue": { "type": "number", "minimum": 0 } } } },
        "storage": { "type": "array", "items": { "type": "object", "required": ["fillType", "amount", "capacity"],
          "properties": { "fillType": { "type": "string" }, "amount": { "type": "number", "minimum": 0 },
            "capacity": { "type": "number", "minimum": 0 } } } }
      }
    },
    "liabilities": { "type": "object", "required": ["vanillaLoan"], "properties": {
      "vanillaLoan": { "type": "object", "required": ["active", "remainingAmount"],
        "properties": { "active": { "type": "boolean" }, "remainingAmount": { "type": "number", "minimum": 0 } } },
      "leasing": { "type": "array", "items": { "type": "object", "required": ["uniqueId"],
        "properties": { "uniqueId": { "type": "string" }, "costPerPeriod": { "type": "number", "minimum": 0 } } } } } },
    "missions": { "type": "array", "items": { "type": "object", "required": ["uniqueId", "status"],
      "properties": { "uniqueId": { "type": "string" }, "status": { "enum": ["AVAILABLE", "RUNNING", "FINISHED"] },
        "title": { "type": "string" }, "typeName": { "type": "string" }, "field": { "type": "string" },
        "npcIndex": { "type": "integer" }, "npcTitle": { "type": "string" }, "reward": { "type": "number" },
        "success": { "type": "boolean" } } } },
    "prices": { "type": "array", "items": { "type": "object", "required": ["sellPoint", "fillType", "currentPrice"],
      "properties": { "sellPoint": { "type": "string" }, "fillType": { "type": "string" },
        "currentPrice": { "type": "number", "minimum": 0 },
        "trend": { "enum": ["CLIMBING", "FALLING", "STABLE"] } } } },
    "calendar": { "type": "object", "required": ["period", "dayInPeriod", "daysPerPeriod", "year", "monotonicDay"],
      "properties": { "period": { "type": "integer", "minimum": 1, "maximum": 12 },
        "dayInPeriod": { "type": "integer", "minimum": 1 }, "daysPerPeriod": { "type": "integer", "minimum": 1 },
        "year": { "type": "integer" }, "monotonicDay": { "type": "integer", "minimum": 0 },
        "periodName": { "type": "string" }, "season": { "type": "string" },
        "dayTimeMs": { "type": "integer", "minimum": 0, "exclusiveMaximum": 86400000 } } },
    "finances": { "type": "object", "required": ["periods"], "properties": {
      "periods": { "type": "array", "items": { "type": "object", "required": ["year", "period", "byType"],
        "properties": { "year": { "type": "integer" }, "period": { "type": "integer", "minimum": 1, "maximum": 12 },
          "byType": { "type": "object", "additionalProperties": { "type": "number" } } } } } } },
    "workforce": { "type": "object", "required": ["activeJobs", "workedGameMs"], "properties": {
      "activeJobs": { "type": "array", "items": { "type": "object", "required": ["jobId"],
        "properties": { "jobId": { "type": "integer" }, "employeeId": { "type": "integer" },
          "title": { "type": "string" } } } },
      "workedGameMs": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } } } },
    "husbandries": { "type": "array", "items": { "type": "object",
      "required": ["husbandryUniqueId", "health", "food", "conditions"],
      "properties": { "husbandryUniqueId": { "type": "string", "minLength": 1 },
        "health": { "type": "number", "minimum": 0 }, "productivity": { "type": "number", "minimum": 0 },
        "food": { "type": "number", "minimum": 0 },
        "conditions": { "type": "array", "items": { "type": "object", "required": ["title", "ratio"],
          "properties": { "title": { "type": "string" }, "ratio": { "type": "number", "minimum": 0 } } } } } } },
    "fields": { "type": "array", "items": { "type": "object",
      "required": ["farmlandId", "name", "hectares", "growthState", "weedState", "stoneLevel", "sprayLevel",
        "limeLevel", "plowLevel"],
      "properties": { "farmlandId": { "type": "integer" }, "name": { "type": "string" },
        "hectares": { "type": "number", "minimum": 0 }, "fruitType": { "type": "string", "minLength": 1 },
        "growthState": { "type": "integer", "minimum": 0 },
        "minHarvestingGrowthState": { "type": "integer", "minimum": 0 },
        "maxHarvestingGrowthState": { "type": "integer", "minimum": 0 },
        "weedState": { "type": "integer", "minimum": 0 }, "stoneLevel": { "type": "integer", "minimum": 0 },
        "sprayLevel": { "type": "integer", "minimum": 0 }, "limeLevel": { "type": "integer", "minimum": 0 },
        "plowLevel": { "type": "integer", "minimum": 0 }, "groundType": { "type": "string" },
        "withered": { "type": "boolean" }, "cut": { "type": "boolean" }, "fillType": { "type": "string", "minLength": 1 },
        "litersPerSqm": { "type": "number", "minimum": 0 }, "sprayType": { "type": "string", "minLength": 1 } } } },
    "fieldRules": { "type": "object", "required": ["plowingRequired", "limeRequired", "weedsEnabled", "stonesEnabled"],
      "properties": { "plowingRequired": { "type": "boolean" }, "limeRequired": { "type": "boolean" },
        "weedsEnabled": { "type": "boolean" }, "stonesEnabled": { "type": "boolean" } } },
    "weather": { "type": "object", "required": ["raining", "rainFallScale", "groundWetness"], "properties": {
      "raining": { "type": "boolean" }, "rainFallScale": { "type": "number", "minimum": 0 },
      "groundWetness": { "type": "number", "minimum": 0 }, "temperature": { "type": "number" },
      "snowHeight": { "type": "number", "minimum": 0 } } },
    "npcFields": { "type": "array", "items": { "type": "object",
      "required": ["farmlandId", "name", "hectares", "growthState", "weedState", "stoneLevel", "sprayLevel",
        "limeLevel", "plowLevel"],
      "properties": { "farmlandId": { "type": "integer" }, "name": { "type": "string" },
        "hectares": { "type": "number", "minimum": 0 }, "fruitType": { "type": "string", "minLength": 1 },
        "growthState": { "type": "integer", "minimum": 0 },
        "minHarvestingGrowthState": { "type": "integer", "minimum": 0 },
        "maxHarvestingGrowthState": { "type": "integer", "minimum": 0 },
        "weedState": { "type": "integer", "minimum": 0 }, "stoneLevel": { "type": "integer", "minimum": 0 },
        "sprayLevel": { "type": "integer", "minimum": 0 }, "limeLevel": { "type": "integer", "minimum": 0 },
        "plowLevel": { "type": "integer", "minimum": 0 }, "groundType": { "type": "string" },
        "withered": { "type": "boolean" }, "cut": { "type": "boolean" }, "fillType": { "type": "string", "minLength": 1 },
        "litersPerSqm": { "type": "number", "minimum": 0 } } } },
    "missionLimitReached": { "type": "boolean" },
    "tradeStorage": { "type": "array", "items": { "type": "object", "required": ["fillType", "amount", "freeCapacity"],
      "properties": { "fillType": { "type": "string", "minLength": 1 }, "amount": { "type": "number", "minimum": 0 },
        "freeCapacity": { "type": "number", "minimum": 0 } } } },
    "vehiclePositions": { "type": "array", "items": { "type": "object", "required": ["uniqueId", "x", "z"],
      "properties": { "uniqueId": { "type": "string", "minLength": 1 }, "x": { "type": "number" },
        "z": { "type": "number" }, "farmlandId": { "type": "integer", "minimum": 1 }, "onCrop": { "type": "boolean" } } } }
  }
}
