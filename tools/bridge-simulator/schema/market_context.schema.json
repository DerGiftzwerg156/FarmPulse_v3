{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_context.schema.json",
  "title": "market_context.json (FS25_RPSim export)",
  "type": "object",
  "required": ["savegameId", "mapName", "sellPoints", "fillTypes", "farmlands"],
  "properties": {
    "savegameId": { "type": "string", "minLength": 1 },
    "mapName": { "type": "string" },
    "sellPoints": { "type": "array", "items": { "type": "object", "required": ["id", "name", "acceptedFillTypes"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" },
        "acceptedFillTypes": { "type": "array", "items": { "type": "string" } } } } },
    "fillTypes": { "type": "array", "items": { "type": "string" } },
    "farmlands": { "type": "array", "items": { "type": "object", "required": ["farmlandId", "hectares", "price", "ownerFarmId"],
      "properties": { "farmlandId": { "type": "integer" }, "hectares": { "type": "number" },
        "price": { "type": "number" }, "ownerFarmId": { "type": "integer", "minimum": 0 },
        "showOnFarmlandsScreen": { "type": "boolean" }, "defaultFarmProperty": { "type": "boolean" },
        "npc": { "type": "object", "required": ["index"], "properties": { "index": { "type": "integer" },
          "name": { "type": "string" }, "title": { "type": "string" } } } } } },
    "detectedMods": { "type": "array", "items": { "type": "string" } }
  }
}
