{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_context.schema.json",
  "title": "market_context.json (FS25_RPSim export)",
  "type": "object",
  "required": ["savegameId", "mapName", "sellPoints", "fillTypes", "farmlands"],
  "properties": {
    "savegameId": { "type": "string", "minLength": 1 },
    "mapName": { "type": "string" },
    "sellPoints": { "type": "array", "items": { "type": "object", "required": ["id", "name", "acceptedFillTypes"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" },
        "acceptedFillTypes": { "type": "array", "items": { "type": "string" } },
        "production": { "type": "boolean" }, "ownedByPlayer": { "type": "boolean" } } } },
    "fillTypes": { "type": "array", "items": { "type": "string" } },
    "farmlands": { "type": "array", "items": { "type": "object", "required": ["farmlandId", "hectares", "price", "ownerFarmId"],
      "properties": { "farmlandId": { "type": "integer" }, "hectares": { "type": "number" },
        "price": { "type": "number" }, "ownerFarmId": { "type": "integer", "minimum": 0 },
        "showOnFarmlandsScreen": { "type": "boolean" }, "defaultFarmProperty": { "type": "boolean" },
        "npc": { "type": "object", "required": ["index"], "properties": { "index": { "type": "integer" },
          "name": { "type": "string" }, "title": { "type": "string" } } } } } },
    "detectedMods": { "type": "array", "items": { "type": "string" } },
    "storeVehicles": { "type": "array", "items": { "type": "object", "required": ["xmlFilename", "name", "price", "isMod"],
      "properties": { "xmlFilename": { "type": "string", "minLength": 1 }, "name": { "type": "string" },
        "price": { "type": "number", "minimum": 0 }, "lifetime": { "type": "number", "minimum": 0 },
        "categoryName": { "type": "string" }, "isMod": { "type": "boolean" }, "motorized": { "type": "boolean" } } } },
    "fieldShapes": { "type": "object", "required": ["mapSize", "fields"], "properties": {
      "mapSize": { "type": "number", "exclusiveMinimum": 0 },
      "fields": { "type": "array", "items": { "type": "object", "required": ["farmlandId", "name", "points"],
        "properties": { "farmlandId": { "type": "integer" }, "name": { "type": "string" },
          "points": { "type": "array", "minItems": 3, "maxItems": 64, "items": { "type": "object",
            "required": ["x", "z"], "properties": { "x": { "type": "number" }, "z": { "type": "number" } } } } } } } } },
    "fruitTypes": { "type": "array", "items": { "type": "object", "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "fillType": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }, "regrows": { "type": "boolean" },
        "needsRolling": { "type": "boolean" },
        "products": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "seedUsagePerSqm": { "type": "number", "minimum": 0 }, "litersPerSqm": { "type": "number", "minimum": 0 },
        "plantablePeriods": { "type": "array", "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "harvestablePeriods": { "type": "array", "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 } } } } },
    "fillTypeCosts": { "type": "array", "items": { "type": "object", "required": ["fillType", "costPerLiter"],
      "properties": { "fillType": { "type": "string", "minLength": 1 },
        "costPerLiter": { "type": "number", "minimum": 0 } } } },
    "animalFood": { "type": "array", "items": { "type": "object", "required": ["animalType", "groups", "mixtures"],
      "properties": { "animalType": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "items": { "type": "object", "required": ["title", "productionWeight", "fillTypes"],
          "properties": { "title": { "type": "string", "minLength": 1 },
            "productionWeight": { "type": "number", "minimum": 0 },
            "fillTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } },
        "mixtures": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
    "storePlaces": { "type": "array", "items": { "type": "object", "required": ["x", "z"],
      "properties": { "x": { "type": "number" }, "z": { "type": "number" } } } }
  }
}
